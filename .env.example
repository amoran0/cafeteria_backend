# Copia este fichero como .env y rellena los valores (el .env no se sube a git)
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=cambia_esto
DB_SCHEMA=cafeteria
# Secreto para firmar los JWT (HS256): al menos 32 caracteres
JWT_SECRETO=cambia_esto_por_un_secreto_largo_de_32_caracteres_o_mas
# Clave que deben enviar en X-API-KEY las otras API para usar /api/v1/integracion/**
SAFAREYES_COFFEESTATION_API_KEY=cambia_esto_por_una_clave_larga
